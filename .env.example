# ==================== TrustCheck Configuration ====================

# ==================== APPLICATION ====================
APP_NAME=TrustCheck
APP_VERSION=3.0.0
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # Enable debug mode
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ==================== SERVER ====================
HOST=0.0.0.0
PORT=8000

# ==================== DATABASE ====================
# SQLite
DATABASE_URL=sqlite+aiosqlite:///data/trustcheck.db

# ==================== SCRAPING ====================
# HTTP request settings
SCRAPING_TIMEOUT=120             # Timeout in seconds
SCRAPING_MAX_RETRIES=3           # Retry attempts for failed requests

# Scraping intervals (in hours)
OFAC_INTERVAL_HOURS=6            # OFAC updates frequently
UN_INTERVAL_HOURS=24             # UN updates daily
EU_INTERVAL_HOURS=24             # EU updates daily
UK_INTERVAL_HOURS=24             # UK updates daily

# ==================== SCREENING ====================
DEFAULT_MATCH_THRESHOLD=0.80     # Minimum score for matches (0.0-1.0)
MAX_SCREENING_RESULTS=100        # Max results per screening request
BATCH_SCREENING_LIMIT=10000      # Max names in batch screening

# ==================== CACHE ====================
CACHE_TTL_SECONDS=300            # Cache TTL (5 minutes)
CACHE_MAX_SIZE=10000             # Max items in memory cache

# ==================== DATA SOURCE URLs (optional overrides) ====================
# OFAC_SDN_URL=https://www.treasury.gov/ofac/downloads/sdn.xml
# UN_CONSOLIDATED_URL=https://scsanctions.un.org/resources/xml/en/consolidated.xml
# EU_SANCTIONS_URL=https://webgate.ec.europa.eu/fsd/fsf/public/files/xmlFullSanctionsList_1_1/content
# UK_SANCTIONS_URL=https://assets.publishing.service.gov.uk/media/65d12cd4cf7eb1001ab5c225/UK_Sanctions_List.ods
